# ============================================================
# .env — Secret settings file. NEVER commit this to GitHub!
# Add ".env" to your .gitignore file to keep it private.
# This file holds real credentials and config values.
# ============================================================

# Which Amazon data center to connect to
AWS_REGION=us-east-1

# The AI model we want to use on Amazon Bedrock.
# "us." prefix = cross-region inference profile (required for on-demand use)
# "haiku-4-5"  = fast and cheap model, great for simple tasks
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
